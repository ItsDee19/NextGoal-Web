# Public API origin (required to point a deployed frontend to its deployed backend).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: configure both values to enable Google sign-in through Supabase.
# Use the public anonymous/publishable key, never a Supabase service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
