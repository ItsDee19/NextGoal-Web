# PostgreSQL: DIRECT_URL can equal DATABASE_URL for local PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/nextgoal
DIRECT_URL=postgresql://postgres:password@localhost:5432/nextgoal

# Redis is required for the Bull queue and coordinated refresh state.
REDIS_URL=redis://localhost:6379

# JWT: replace the placeholder with a strong random secret.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional Google sign-in through Supabase; configure both to enable OAuth exchange.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Application origins.
PORT=3001
FRONTEND_URL=http://localhost:3000

# Demo account seeding is opt-in and always disabled with NODE_ENV=production.
ALLOW_DEMO_SEED=false

# English publication: none, libretranslate, or google.
# Source originals remain private until English publication is ready.
# Setting a provider and its connection enables translation calls during ingestion/backfill.
TRANSLATION_PROVIDER=none

# Self-hosted LibreTranslate can run without an API key; use a base URL without /translate.
# Example: http://localhost:5000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Google Cloud Translation Basic v2; enabling this requires your configured account/billing.
GOOGLE_TRANSLATE_API_KEY=
