# PostgreSQL: DIRECT_URL can equal DATABASE_URL for local PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/nextgoal
DIRECT_URL=postgresql://postgres:password@localhost:5432/nextgoal

# api = HTTP only (Render); combined = API + local queues and schedules (default).
# The standalone jobs:maintain command always uses its separate worker module.
APP_MODE=combined

# Redis is required only for combined mode and jobs:maintain, never APP_MODE=api.
# For hosted Redis use its TLS rediss:// connection URL, not a REST endpoint.
REDIS_URL=redis://localhost:6379

# JWT: production requires a unique secret with at least 32 characters.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional Google sign-in through Supabase; configure both to enable OAuth exchange.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Exact browser origins, separated by commas; no paths, trailing slashes or wildcards.
# Production requires HTTPS, for example https://nextgoal.vercel.app.
PORT=3001
FRONTEND_URL=http://localhost:3000

# Optional operator secret (at least 32 characters). Combined-mode maintenance
# routes require BOTH a user JWT and the X-Maintenance-Secret header.
# Leaving this unset disables HTTP maintenance. APP_MODE=api always disables it.
# GitHub Actions runs the CLI and does not need this secret.
MAINTENANCE_SECRET=

# Demo account seeding is opt-in and always disabled with NODE_ENV=production.
ALLOW_DEMO_SEED=false

# English publication: none, libretranslate, or google.
# Source originals remain private until English publication is ready.
# Setting a provider and its connection enables translation calls during ingestion/backfill.
TRANSLATION_PROVIDER=none

# Self-hosted LibreTranslate can run without an API key; use a base URL without /translate.
# Example: http://localhost:5000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Google Cloud Translation Basic v2; enabling this requires your configured account/billing.
GOOGLE_TRANSLATE_API_KEY=
